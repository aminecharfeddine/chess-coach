{
  "name": "eldrachess",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Entraînement aux échecs contre Stockfish avec barre d'évaluation et entraîneur en direct",
  "scripts": {
    "copy-engine": "node scripts/copy-engine.mjs",
